# Copy to .env and fill in your project values. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Manila

# Server-only Mapbox token and exact base pickup address for driving estimates.
MAPBOX_ACCESS_TOKEN=
MAPBOX_ORIGIN_ADDRESS=

# Shared rate limiter for production replicas. Never expose the token publicly.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Enable for production after configuring Redis.
REQUIRE_DISTRIBUTED_RATE_LIMIT=false
# Set only to the client-IP header your trusted ingress overwrites (see SECURITY.md).
TRUSTED_PROXY_IP_HEADER=
